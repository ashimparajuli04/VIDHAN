{
  "name": "@vidhan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest": "tsx src/ingest/cli.ts",
    "db:seed": "tsx src/seed/lawyers.ts",
    "db:seed:load": "wrangler d1 execute DB --local --file=../../data/lawyers.seed.sql"
  },
  "dependencies": {
    "@vidhan/schema": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.145.0"
  }
}
